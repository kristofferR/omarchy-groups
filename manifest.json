{
  "schemaVersion": 1,
  "id": "kristofferr.groups",
  "name": "Groups",
  "version": "1.3.0",
  "author": "Kristoffer Risanger (@kristofferR)",
  "description": "Independent icon groups for Omarchy: drawers below the bar, drag-and-drop organization, and native widget interactions.",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Settings.qml"
  },
  "barWidget": {
    "displayName": "Groups",
    "description": "Independent icon groups for Omarchy: drawers below the bar, drag-and-drop organization, and native widget interactions.",
    "category": "Layout",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "items": [],
      "trigger": "hover",
      "duration": 0,
      "groupId": "",
      "label": "Group",
      "icon": "group",
      "showBorder": true
    },
    "schema": [
      {
        "key": "groupId",
        "type": "string",
        "label": "Unique group ID",
        "defaultValue": ""
      },
      {
        "key": "label",
        "type": "string",
        "label": "Group name",
        "defaultValue": "Group"
      },
      {
        "key": "icon",
        "type": "string",
        "label": "Icon name",
        "defaultValue": "group"
      },
      {
        "key": "trigger",
        "type": "enum",
        "label": "Open on",
        "options": [
          "hover",
          "click"
        ],
        "defaultValue": "hover"
      },
      {
        "key": "duration",
        "type": "integer",
        "label": "Reveal duration (ms)",
        "min": 0,
        "max": 1000,
        "defaultValue": 0
      },
      {
        "key": "showBorder",
        "type": "boolean",
        "label": "Show icon border",
        "defaultValue": true
      }
    ]
  },
  "license": "MIT",
  "icon": "assets/icon.svg",
  "preview": "preview.png"
}
